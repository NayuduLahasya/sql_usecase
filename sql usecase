--  1. Display all orders with customer and product names
SELECT
    o.order_id,
    c.customer_name,
    p.product_name,
    o.quantity,
    o.status
FROM orders o
JOIN customers c
ON o.customer_id = c.customer_id
JOIN products p
ON o.product_id = p.product_id;

-- 2. Total order amount for each customer
SELECT
    c.customer_name,
    SUM(o.quantity * p.price) AS total_amount
FROM orders o
JOIN customers c
ON o.customer_id = c.customer_id
JOIN products p
ON o.product_id = p.product_id
GROUP BY c.customer_name;

-- 3. Number of orders for each status
SELECT
    status,
    COUNT(*) AS order_count
FROM orders
GROUP BY status;

-- 4. Product with highest total sales amount
SELECT
    p.product_name,
    SUM(o.quantity * p.price) AS total_sales
FROM orders o
JOIN products p
ON o.product_id = p.product_id
GROUP BY p.product_name
ORDER BY total_sales DESC
LIMIT 1;

-- 5. Customers who have not placed any orders
SELECT
    c.customer_id,
    c.customer_name
FROM customers c
LEFT JOIN orders o
ON c.customer_id = o.customer_id
WHERE o.customer_id IS NULL;



